{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/business-creation/document-record.schema.json",
  "title": "Business Creation Document Record v0.1",
  "description": "Draft metadata contract; no production integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "owner",
    "date",
    "domain",
    "venture_type",
    "status",
    "assumptions",
    "evidence",
    "decision",
    "next_action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string",
      "pattern": "^(0[0-9]|1[01])$"
    },
    "scope": {
      "type": "string"
    },
    "geography": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "venture_type": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "manufacturing",
          "services",
          "commerce",
          "digital",
          "hybrid",
          "local_micro",
          "social_cooperative",
          "multi_enterprise"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "hypothesis",
        "in-test",
        "validated",
        "invalidated",
        "decision",
        "superseded"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "summary",
          "source",
          "limitations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "observation",
              "interview",
              "experiment",
              "official_data",
              "synthetic",
              "estimate"
            ]
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "string"
    }
  }
}
